# Server port for the backend
PORT=5001

# Runtime environment: development | production | test
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/ecommerce

# Single administrator credentials.
# Generate ADMIN_PASSWORD_HASH with: npm run admin:hash
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt$<salt>$<hash>
ADMIN_TOKEN_SECRET=replace-with-a-random-string-at-least-32-chars
ADMIN_TOKEN_TTL_SECONDS=28800